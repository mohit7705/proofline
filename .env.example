# ---- Database (docker compose) ----
POSTGRES_DB=proofline
POSTGRES_USER=proofline
POSTGRES_PASSWORD=change-me-before-real-use

# ---- Security ----
# Required. Use a long random value, for example: openssl rand -hex 32
JWT_SECRET_KEY=
# Optional Google sign-in (same client id for API and frontend)
GOOGLE_CLIENT_ID=

# ---- AI (Meta models) ----
# Leave MODEL_API_KEY empty to run without AI: AI routes answer 503.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai
META_API_TIMEOUT_SECONDS=60
VIDEO_ANALYSIS_MODEL=muse-spark-1.3
VIDEO_ANALYSIS_ENDPOINT=/v1/responses
# true = fixed sample AI answers (no key, no internet). Good for demos and tests.
MODEL_MOCK=false

# ---- Verification rules ----
VERIFICATION_MIN_CONFIDENCE=0.6
VERIFICATION_MAX_FOLLOW_UPS=3
SELF_APPROVE_ENABLED=true
SELF_APPROVE_MIN_SCORE=80

# ---- Web ----
# Comma-separated sites allowed to call the API from a browser. Empty = off.
# Not needed with docker compose (the web service proxies /api).
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
# true only behind a proxy that sets X-Forwarded-For (the web service does).
TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO
WEB_PORT=8080
