# Copy to .env for local development. Values starting with VITE_ are public: they are
# baked into the browser bundle, so never put a secret here.

# Shows the "Continue with Google" button. Must match GOOGLE_CLIENT_ID on the backend.
# Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Where the browser sends API calls. The default "/api" works with the Vite dev proxy
# and with the nginx container. Set a full URL (https://api.example.com) only if the
# API is on a different origin, and then allow that origin in the backend CORS settings.
VITE_API_BASE=/api
